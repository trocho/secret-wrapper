{
  "name": "@trocho/secret-wrapper",
  "version": "0.6.3",
  "description": "Local-first secret adapters for launching tools and MCP servers.",
  "type": "module",
  "bin": {
    "secret-wrapper": "bin/secret-wrapper.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills/secret-wrapper",
    "docs/assets"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:package-install": "node tests/scripts/verify-package-install.mjs",
    "sync:plugin-skill": "node tests/scripts/sync-plugin-skill.mjs",
    "check:plugin-skill": "node tests/scripts/sync-plugin-skill.mjs --check",
    "test:skill-discovery": "node tests/scripts/verify-skill-discovery.mjs",
    "test:plugin-install": "docker build --pull --file tests/integration/Dockerfile.plugin-install --tag secret-wrapper-plugin-install-test . && docker run --rm secret-wrapper-plugin-install-test && docker run --rm secret-wrapper-plugin-install-test && docker image rm secret-wrapper-plugin-install-test",
    "validate": "node tests/scripts/validate.mjs",
    "pack:check": "npm pack --dry-run",
    "promotion:apply": "node maintenance/promotion/github-metadata.mjs --apply",
    "promotion:check": "node maintenance/promotion/github-metadata.mjs --check",
    "promotion:measure": "node maintenance/promotion/measure.mjs",
    "skill:fingerprint": "node maintenance/promotion/scripts/update-skill-fingerprint.mjs",
    "skill:fingerprint:check": "node maintenance/promotion/scripts/update-skill-fingerprint.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trocho/secret-wrapper.git"
  },
  "bugs": {
    "url": "https://github.com/trocho/secret-wrapper/issues"
  },
  "homepage": "https://github.com/trocho/secret-wrapper#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "secrets",
    "mcp",
    "coding-agents",
    "keychain",
    "bitwarden",
    "1password",
    "security"
  ]
}
